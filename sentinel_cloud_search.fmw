DEFAULT_MACRO client_email mikajan0509@onet.pl

DEFAULT_MACRO county_name tarnowski

DEFAULT_MACRO max_cloud_coverage 20

DEFAULT_MACRO start_date 20250612000000

DEFAULT_MACRO end_date 20250615000000

