FACTORY_DEF {*} JSONQueryFactory    FACTORY_NAME { $(SentinelDownloader_WORKSPACE_NAME)_JSONFragmenter_3 }    INPUT  FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_HTTPCaller_8_Output"    MODE EXPLODE    EXPLODE_FORMAT { JSON }    REJECT_EMPTY_LISTS { YES }    EXTRACT_ATTR { Yes }    JSON_ATTR { "_response_body" }    READ_FROM_FILE { NO }    FILEPATH_OR_URL { "<Unused>" }    OUTPUT_ATTRIBUTE { "<Unused>" }    EXPLODE_QUERY { "json<openbracket><quote>result<quote><closebracket><openbracket>*<closebracket>" }    RECURSIVE_FLATTEN { YES }    OUTPUT { EXPLODED FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_JSONFragmenter_3_FRAGMENTS"        }    OUTPUT { REJECTED FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_JSONFragmenter_3_<REJECTED>"        }
