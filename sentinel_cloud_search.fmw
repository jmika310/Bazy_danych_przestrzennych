FACTORY_DEF {*} TestFactory FACTORY_NAME { $(SentinelDownloader_WORKSPACE_NAME)_TestFilter } INPUT FEATURE_TYPE $(SentinelDownloader_WORKSPACE_NAME)_TestFilter_INPUTLINE FEATURE_TABLE_SHIM_SUPPORT Yes PASSED_TEST_GROUP_OUTPUT FIRST TEST_GROUP TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_ALL_BANDS$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter) = YES ENCODED } CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Id<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_TestFilter) ENDS_WITH B01_20m.jp2 ENCODED } CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Id<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_TestFilter) ENDS_WITH B02_10m.jp2 ENCODED } CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Id<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_TestFilter) ENDS_WITH B03_10m.jp2 ENCODED } CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Id<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_TestFilter) ENDS_WITH B04_10m.jp2 ENCODED } CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Id<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_TestFilter) ENDS_WITH B05_20m.jp2 ENCODED } CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Id<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_TestFilter) ENDS_WITH B06_20m.jp2 ENCODED } CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Id<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_TestFilter) ENDS_WITH B07_20m.jp2 ENCODED } CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Id<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_TestFilter) ENDS_WITH B08_10m.jp2 ENCODED } CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Id<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_TestFilter) ENDS_WITH B09_60m.jp2 ENCODED } CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Id<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_TestFilter) ENDS_WITH B11_20m.jp2 ENCODED } CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Id<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_TestFilter) ENDS_WITH B12_20m.jp2 ENCODED } CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Id<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_TestFilter) ENDS_WITH TCI_10m.jp2 ENCODED } BOOLEAN_OPERATOR COMPOSITE COMPOSITE_TEST_EXPR "1 AND ( 2 OR 3 OR 4 OR 5 OR 6 OR 7 OR 8 OR 9 OR 10 OR 11 OR 12 OR 13 )" OUTPUT PASSED_0 FEATURE_TYPE $(SentinelDownloader_WORKSPACE_NAME)_TestFilter_ALL<space>option TEST_GROUP CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_ALL_BANDS_10$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter) = YES ENCODED } CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Id<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_TestFilter) ENDS_WITH _10m.jp2 ENCODED } CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_B2_10m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter) = YES ENCODED } CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Id<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_TestFilter) ENDS_WITH _B02_10m.jp2 ENCODED } CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_B3_10m$encode),$(SentinelDownloader_WORKSPACE_NAME)_TestFilter) = YES ENCODED } CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Id<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_TestFilter) ENDS_WITH _B03_10m.jp2 ENCODED } CASE_INSENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,$($(SentinelDownloader_WORKSPACE_NAME)_B4_10m