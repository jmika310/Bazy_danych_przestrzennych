FACTORY_DEF {*} AttrSetFactory    FACTORY_NAME { $(SentinelDownloader_WORKSPACE_NAME)_AttributeCreator_3 }    COMMAND_PARM_EVALUATION SINGLE_PASS    INPUT  FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_Tester_6_FAILED"    MULTI_FEATURE_MODE { NO }    NULL_ATTR_MODE { NO_OP }    ATTRSET_CREATE_DIRECTIVES _PROPAGATE_MISSING_FDIV    NUM_OF_COLUMNS 5    ATTR_ACTION { "" "url" "SET_TO" "<at>Value<openparen>url<closeparen><amp><dollar>top=1" "varchar<openparen>200<closeparen>" }    OUTPUT { OUTPUT FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_AttributeCreator_3_OUTPUT"        }
# -------------------------------------------------------------------------
# Build the List removal function and regular expression if there was any list attributes to be removed.
# If not, then we will not have any extra list removal call to @RemoveAttributes, which speeds the
# normal, non-list removal especially when in Bulk Mode.  Note that this computation of the regular expressions is done
# once during mapping file parse time.
INCLUDE [    set listAttributeRemoveRegexps {};    set anyList {no};    foreach attr [split ""] {       set attr [FME_DecodeText $attr];       set attr [regsub "{}$" $attr "{}.*"];       set attr [regsub -all "{}" $attr "\\{\[0-9\]+\\}"];       append listAttributeRemoveRegexps ",^$attr$";       set anyList {yes};    };    if { ${anyList} == {no} } {        puts {MACRO $(SentinelDownloader_WORKSPACE_NAME)_AttributeRemover_7_LIST_FUNC }    } else {        puts "MACRO $(SentinelDownloader_WORKSPACE_NAME)_AttributeRemover_7_LIST_FUNC @RemoveAttributes(fme_pcre_match\"$listAttributeRemoveRegexps\")"    }; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(SentinelDownloader_WORKSPACE_NAME)_AttributeRemover_7 }    INPUT  FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_Tester_6_PASSED"    INPUT  FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_AttributeCreator_3_OUTPUT"    OUTPUT { FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_AttributeRemover_7_OUTPUT"        @RemoveAttributes(fme_encoded,_END,_geometry,_LEVEL)        $($(SentinelDownloader_WORKSPACE_NAME)_AttributeRemover_7_LIST_FUNC)         }
# -------------------------------------------------------------------------
# Create a FME_UUID_SAFE from the FME_UUID so we can use it for Tcl identifiers (FMEDESKTOP-11308)
INCLUDE [ FME_CleanseFMEUUID {$(SentinelDownloader_WORKSPACE_NAME)_Logger_7_a742b6f5_6b82_4f9e_b39e_87e7c650d10423} ]
# If the Logger was in a custom transformer, the custom transformer's name was not being
# properly logged -- instead we saw "$(<customXformerName_WORKSPACE_NAME)" being logged as the prefix of the
# message. By deferencing and expanding out the XFORMER_NAME below, and then "WWJD" encoding it when it is
# used in the @Log call via the $encode macro name suffix trick, we get the right result, and the right result
# safely.
MACRO LOGGABLE_XFORMER_NAME $(SentinelDownloader_WORKSPACE_NAME)_Logger_7
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(SentinelDownloader_WORKSPACE_NAME)_Logger_7_Logger }    INPUT  FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_AttributeRemover_7_OUTPUT"    OUTPUT { FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_Logger_7_LOGGED"                  @Log(ENCODED, "$(LOGGABLE_XFORMER_NAME$encode):<space>@EvaluateExpression(FDIV,STRING_ENCODED,HTTP<space>request<space>against<space><at>Value<openparen>url<closeparen><space>...,$(SentinelDownloader_WORKSPACE_NAME)_Logger_7)","<Unused>","20","",INFO,NONE,$(FME_UUID_SAFE))                   }
# -------------------------------------------------------------------------
# Combine the two "file path attribute" parameters into one value.
DEFAULT_MACRO $(SentinelDownloader_WORKSPACE_NAME)_HTTPCaller_3_FILE_PATH_ATTR
INCLUDE [ 	if { {<Unused>} == {<Unused>} } { 		puts {MACRO $(SentinelDownloader_WORKSPACE_NAME)_HTTPCaller_3_FILE_PATH_ATTR "<Unused>"}; 	} else { 		puts {MACRO $(SentinelDownloader_WORKSPACE_NAME)_HTTPCaller_3_FILE_PATH_ATTR "<Unused>"}; 	} ]
FACTORY_DEF {*} HTTPFactory    FACTORY_NAME { $(SentinelDownloader_WORKSPACE_NAME)_HTTPCaller_3 }       INPUT  FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_Logger_7_LOGGED"    TARGET_URL { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>url<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_HTTPCaller_3)" }    HTTP_METHOD { GET }    SAVE_FILE { NO }    OUTPUT_FILENAME { "<Unused>" }    OUTPUT_DIRECTORY { "<Unused>" }    FILE_EXTENSION { "<Unused>" }    TARGET_ATTR { "_response_body" }    FILE_PATH_ATTR { $($(SentinelDownloader_WORKSPACE_NAME)_HTTPCaller_3_FILE_PATH_ATTR) }    UPLOAD_FILE { "<Unused>" }    UPLOAD_BODY { "<Unused>" }    UPLOAD_TYPE { <Unused> }    UPLOAD_CONTENT_TYPE { "<Unused>" }    COMBINED_MULTIPART_TABLE {  }    MULTIPART_CONTENT_TYPE { <Unused> }    REQUEST_HEADER_TABLE {  }    ADDITIONAL_URL_PARAMETERS {  }    AUTH_USERNAME { "<Unused>" }    AUTH_PASSWORD { "<Unused>" }    AUTH_METHOD { "<Unused>" }    TARGET_ATTRIBUTE_ENCODING { auto-detect }    RESPONSE_HEADER_LIST_ATTR { "" }    STATUS_CODE_ATTR { "_http_status_code" }    ERROR_ATTR { "_error" }    CONNECTION_TIMEOUT_LENGTH { 60 }    TRANSFER_TIMEOUT_LENGTH { 90 }    FOLLOW_REDIRECTS { FOLLOW_WITH_ORIGINAL_METHOD }    REDIRECT_AUTH { ORIGINAL_DOMAIN_ONLY }    VERIFY_SSL_CERTIFICATES { Yes }    NAMED_CONNECTION { "<Unused>" }    USE_COOKIES { No }    MAX_TRANSFERS_IN_PROGRESS { 25 }    MAX_HTTP_VERSION { HTTP_2 }    RATE_LIMIT_MAX_REQUESTS { <Unused> }    RATE_LIMIT_INTERVAL_IN_SECONDS { <Unused> }    RATE_LIMIT_REQUEST_TIMING { <Unused> }    RETRY_FAILED_TRANSFERS { <Unused> }    RETRY_MAX_RETRIES { <Unused> }    RETRY_INITIAL_BACKOFF { <Unused> }    SPLIT_MULTIPART_RESPONSE { NO }    MULTIPART_RESPONSE_HEADER_LIST_ATTR { "<Unused>" }    MINIMUM_ENCRYPTION_LEVEL { "OS_DEFAULT" }    CLIENT_CERTIFICATE_TYPE { "NONE" }    CLIENT_CERTIFICATE_FROM_OS { "<Unused>" }    CLIENT_CERTIFICATE_FILE { "<Unused>" }    CLIENT_CERTIFICATE_PRIVATE_KEY_FILE { "<Unused>" }    CLIENT_CERTIFICATE_PASSWORD { "<Unused>" }    OUTPUT { OUTPUT FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_HTTPCaller_3_Output"          }    OUTPUT { REJECTED FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_HTTPCaller_3_<REJECTED>"          }
# -------------------------------------------------------------------------
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(SentinelDownloader_WORKSPACE_NAME)_Junction_5 }    INPUT  FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_HTTPCaller_3_<REJECTED>"    OUTPUT { FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_Junction_5_Output"         }
# -------------------------------------------------------------------------
FACTORY_DEF {*} AttributeKeeperFactory    FACTORY_NAME { $(SentinelDownloader_WORKSPACE_NAME)_AttributeKeeper }    INPUT  FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_HTTPCaller_3_Output"    KEEP_ATTRS { _response_body,access_token }    KEEP_LISTS {  }    KEEP_FME_ATTRIBUTES Yes    BUILD_FEATURE_TABLES { NO }    OUTPUT_ON_ATTRIBUTE_CHANGE { <Unused> }    OUTPUT { OUTPUT FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_AttributeKeeper_OUTPUT"        }
# -------------------------------------------------------------------------
FACTORY_DEF {*} JSONQueryFactory    FACTORY_NAME { $(SentinelDownloader_WORKSPACE_NAME)_JSONFragmenter_4 }    INPUT  FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_AttributeKeeper_OUTPUT"    MODE EXPLODE    EXPLODE_FORMAT { JSON }    REJECT_EMPTY_LISTS { YES }    EXTRACT_ATTR { Yes }    JSON_ATTR { "_response_body" }    READ_FROM_FILE { NO }    FILEPATH_OR_URL { "<Unused>" }    OUTPUT_ATTRIBUTE { "<Unused>" }    EXPLODE_QUERY { "json<openbracket><quote>value<quote><closebracket><openbracket>*<closebracket>" }    RECURSIVE_FLATTEN { YES }    OUTPUT { EXPLODED FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_JSONFragmenter_4_FRAGMENTS"        }    OUTPUT { REJECTED FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_JSONFragmenter_4_<REJECTED>"        }
# -------------------------------------------------------------------------
# Build the List removal function and regular expression if there was any list attributes to be removed.
# If not, then we will not have any extra list removal call to @RemoveAttributes, which speeds the
# normal, non-list removal especially when in Bulk Mode.  Note that this computation of the regular expressions is done
# once during mapping file parse time.
INCLUDE [    set listAttributeRemoveRegexps {};    set anyList {no};    foreach attr [split ""] {       set attr [FME_DecodeText $attr];       set attr [regsub "{}$" $attr "{}.*"];       set attr [regsub -all "{}" $attr "\\{\[0-9\]+\\}"];       append listAttributeRemoveRegexps ",^$attr$";       set anyList {yes};    };    if { ${anyList} == {no} } {        puts {MACRO $(SentinelDownloader_WORKSPACE_NAME)_AttributeRemover_2_LIST_FUNC }    } else {        puts "MACRO $(SentinelDownloader_WORKSPACE_NAME)_AttributeRemover_2_LIST_FUNC @RemoveAttributes(fme_pcre_match\"$listAttributeRemoveRegexps\")"    }; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(SentinelDownloader_WORKSPACE_NAME)_AttributeRemover_2 }    INPUT  FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_JSONFragmenter_4_FRAGMENTS"    OUTPUT { FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_AttributeRemover_2_OUTPUT"        @RemoveAttributes(fme_encoded,json_index,json_type)        $($(SentinelDownloader_WORKSPACE_NAME)_AttributeRemover_2_LIST_FUNC)         }
# -------------------------------------------------------------------------
FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(SentinelDownloader_WORKSPACE_NAME)_Tester_7 }    INPUT  FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_AttributeRemover_2_OUTPUT"    TEST { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Online<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_Tester_7)" = Yes ENCODED }    BOOLEAN_OPERATOR { OR }    COMPOSITE_TEST_EXPR { "<Unused>" }    PRESERVE_FEATURE_ORDER { PER_OUTPUT_PORT }    OUTPUT { PASSED FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_Tester_7_PASSED"         }    OUTPUT { FAILED FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_Tester_7_FAILED"         }
# -------------------------------------------------------------------------
# Create a FME_UUID_SAFE from the FME_UUID so we can use it for Tcl identifiers (FMEDESKTOP-11308)
INCLUDE [ FME_CleanseFMEUUID {$(SentinelDownloader_WORKSPACE_NAME)_Logger_5_438aebfd_3c0e_4445_a96b_be13f9e1c48523} ]
# If the Logger was in a custom transformer, the custom transformer's name was not being
# properly logged -- instead we saw "$(<customXformerName_WORKSPACE_NAME)" being logged as the prefix of the
# message. By deferencing and expanding out the XFORMER_NAME below, and then "WWJD" encoding it when it is
# used in the @Log call via the $encode macro name suffix trick, we get the right result, and the right result
# safely.
MACRO LOGGABLE_XFORMER_NAME $(SentinelDownloader_WORKSPACE_NAME)_Logger_5
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(SentinelDownloader_WORKSPACE_NAME)_Logger_5_Logger }    INPUT  FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_Tester_7_PASSED"    OUTPUT { FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_Logger_5_LOGGED"                  @Log(ENCODED, "$(LOGGABLE_XFORMER_NAME$encode):<space>Reqeusted<space>data<space>is<space>ONLINE.<space>Download<space>will<space>be<space>triggered<space>now.","<Unused>","20","",WARN,NONE,$(FME_UUID_SAFE))                   }
