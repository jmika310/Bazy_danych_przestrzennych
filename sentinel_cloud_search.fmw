WORKSPACE_NAME)_TestFilter_4) CONTAINS_REGEX B06 ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_5 FEATURE_TYPE $(SentinelDownloader_WORKSPACE_NAME)_TestFilter_4_B06 TEST_GROUP CASE_SENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>fme_basename<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_4) CONTAINS_REGEX B07 ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_6 FEATURE_TYPE $(SentinelDownloader_WORKSPACE_NAME)_TestFilter_4_B07 TEST_GROUP CASE_SENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>fme_basename<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_4) CONTAINS_REGEX B08 ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_7 FEATURE_TYPE $(SentinelDownloader_WORKSPACE_NAME)_TestFilter_4_B08 TEST_GROUP CASE_SENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>fme_basename<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_4) CONTAINS_REGEX B8A ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_8 FEATURE_TYPE $(SentinelDownloader_WORKSPACE_NAME)_TestFilter_4_B8A TEST_GROUP CASE_SENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>fme_basename<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_4) CONTAINS_REGEX B09 ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_9 FEATURE_TYPE $(SentinelDownloader_WORKSPACE_NAME)_TestFilter_4_B09 TEST_GROUP CASE_SENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>fme_basename<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_4) CONTAINS_REGEX B10 ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_10 FEATURE_TYPE $(SentinelDownloader_WORKSPACE_NAME)_TestFilter_4_B10 TEST_GROUP CASE_SENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>fme_basename<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_4) CONTAINS_REGEX B11 ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_11 FEATURE_TYPE $(SentinelDownloader_WORKSPACE_NAME)_TestFilter_4_B11 TEST_GROUP CASE_SENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>fme_basename<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_4) CONTAINS_REGEX B12 ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_12 FEATURE_TYPE $(SentinelDownloader_WORKSPACE_NAME)_TestFilter_4_B12 TEST_GROUP CASE_SENSITIVE_TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>fme_basename<closeparen>,$(SentinelDownloader_WORKSPACE_NAME)_TestFilter_4) CONTAINS_REGEX TCI ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_13 FEATURE_TYPE $(SentinelDownloader_WORKSPACE_NAME)_TestFilter_4_TCI OUTPUT FAILED FEATURE_TYPE $(SentinelDownloader_WORKSPACE_NAME)_TestFilter_4_<lt>UNFILTERED<gt>
