INCLUDE [ FME_CleanseFMEUUID {$(SentinelDownloader_WORKSPACE_NAME)_Logger_4_63bdc3f4_ff6e_4cf7_8e00_f3d05ad4909f23} ]
# If the Logger was in a custom transformer, the custom transformer's name was not being
# properly logged -- instead we saw "$(<customXformerName_WORKSPACE_NAME)" being logged as the prefix of the
# message. By deferencing and expanding out the XFORMER_NAME below, and then "WWJD" encoding it when it is
# used in the @Log call via the $encode macro name suffix trick, we get the right result, and the right result
# safely.
MACRO LOGGABLE_XFORMER_NAME $(SentinelDownloader_WORKSPACE_NAME)_Logger_4
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(SentinelDownloader_WORKSPACE_NAME)_Logger_4_Logger }    INPUT  FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_Tester_7_FAILED"    OUTPUT { FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_Logger_4_LOGGED"                  @Log(ENCODED, "$(LOGGABLE_XFORMER_NAME$encode):<space>Reqeusted<space>data<space>is<space>NOT<space>ONLINE.<space>Sentinel<apos>s<space>Long<space>Time<space>Archive<space><openparen>LTA<closeparen><space>will<space>be<space>triggered<space>now.<space>If<space>successfull<comma><space>data<space>will<space>be<space>available<space>within<space>hours.<lf>For<space>further<space>information<comma><space>see<space>https:<solidus><solidus>scihub.copernicus.eu<solidus>userguide<solidus>LongTermArchive<space>","<Unused>","20","",WARN,NONE,$(FME_UUID_SAFE))                   }
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(SentinelDownloader_WORKSPACE_NAME)_Logger_4 LOGGED Splitter"   INPUT FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_Logger_4_LOGGED"   OUTPUT FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_Logger_4_LOGGED_0_JxAorSs1NOY="   OUTPUT FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_Logger_4_LOGGED_1_LUhSVztzoyQ="
