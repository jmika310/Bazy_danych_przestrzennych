FACTORY_DEF {*} ExecuteFunctionFactory    FACTORY_NAME { $(SentinelDownloader_WORKSPACE_NAME)_CoordinateExtractor_SPECIFIC_Z }    INPUT { FEATURE_TYPE $(SentinelDownloader_WORKSPACE_NAME)_CoordinateExtractor_SPECIFIC_Z_INPUT }    FUNCTION_DEFINITION { @Coordinate(REJECTABLE,z,"0",FLATTEN_AGGREGATE,NO) }    RESULT_ATTRIBUTE { "" }    PRESERVE_FEATURE_ORDER PER_OUTPUT_PORT    OUTPUT { COMPLETE FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_CoordinateExtractor_OUTPUT"        }    OUTPUT { REJECTED FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_CoordinateExtractor_<REJECTED>"        }
