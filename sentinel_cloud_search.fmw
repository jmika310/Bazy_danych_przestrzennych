FACTORY_DEF {*} GeometryFilterFactory    COMMAND_PARM_EVALUATION SINGLE_PASS    FACTORY_NAME { $(SentinelDownloader_WORKSPACE_NAME)_GeometryFilter }    INPUT  FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_ParameterFetcher_2_OUTPUT"    PRESERVE_FEATURE_ORDER { ACROSS_OUTPUT_PORTS }    FILTER_TYPES { Point,Area }    INSTANCES { INSTANTIATE }    BREAK_AGG { Yes }    OUTPUT { <UNFILTERED> FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_GeometryFilter_<UNFILTERED>"  }    OUTPUT { Point FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_GeometryFilter_Point"  }    OUTPUT { Area FEATURE_TYPE "$(SentinelDownloader_WORKSPACE_NAME)_GeometryFilter_Area"  }
